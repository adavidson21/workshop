// Cloudflare Worker for workshop.alexisdavidson.org. The site is this repo's static files, every app included;
// worker/index.js serves the installers and redirects retired app domains to Pop out (see that file).
// dispatch.alexisdavidson.org stays attached only so it redirects (until Feb 1, 2027, docs/site.md).
{
  "name": "workshop",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "workshop.alexisdavidson.org", "custom_domain": true },
    { "pattern": "dispatch.alexisdavidson.org", "custom_domain": true }
  ]
}
