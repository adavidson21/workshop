// Cloudflare Worker for notes.alexisdavidson.org: this repo's static files, nothing else.
// Deploy with `npx wrangler deploy` (or connect Workers Builds to deploy from main). Workshop
// (workshop.alexisdavidson.org) shows Notes inside its shell by proxying /apps/notes/* to this Worker
// (a service binding named NOTES in Workshop's wrangler.jsonc), so a deploy here updates both.
// Keep the name "notes": the binding refers to it.
{
  "name": "notes",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "notes.alexisdavidson.org", "custom_domain": true }
  ]
}
