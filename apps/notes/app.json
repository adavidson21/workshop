{
  "manifestVersion": 1,
  "id": "notes",
  "name": "Folio",
  "version": "4.10.1",
  "description": "Folio, your notebook: notes, daily notes, product notes, templates, Tandem's documents and a Links directory, as Markdown files. Diagrams, backlinks, tags, search and images.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 45,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "capture": [
    "note"
  ],
  "routes": [
    {
      "path": ":note",
      "title": "Open a note"
    },
    {
      "path": "tandem/:folder/:file",
      "title": "Open a Tandem document"
    },
    {
      "path": "today",
      "title": "Today's note"
    },
    {
      "path": "review",
      "title": "Product notes to review"
    },
    {
      "path": "links",
      "title": "Find a link"
    }
  ],
  "commands": [
    {
      "id": "new",
      "title": "New note"
    },
    {
      "id": "search",
      "title": "Search notes"
    },
    {
      "id": "today",
      "title": "Open today's note"
    },
    {
      "id": "diagram",
      "title": "Insert diagram"
    },
    {
      "id": "toggle-pages",
      "title": "Show or hide the pages list"
    },
    {
      "id": "toggle-panel",
      "title": "Show or hide the page panel"
    },
    {
      "id": "bookmark",
      "title": "Bookmark this note (or remove it)"
    },
    {
      "id": "window",
      "title": "Open this note in a new window"
    },
    {
      "id": "links",
      "title": "Find a link"
    },
    {
      "id": "add-link",
      "title": "Add a link"
    }
  ],
  "handoffs": {
    "sends": [
      "prioritizer",
      "receipts"
    ]
  },
  "data": [
    "taken",
    "products-made",
    "bookmarks",
    "handoffs",
    "summary",
    "links-ignored"
  ],
  "files": [
    "js/applinks.js",
    "js/bookmarks.js",
    "js/daily.js",
    "js/data.js",
    "js/diagram-kits.js",
    "js/diagrams.js",
    "js/editor.js",
    "js/edits.js",
    "js/embeds.js",
    "js/export.js",
    "js/highlight.js",
    "js/history.js",
    "js/lenses.js",
    "js/links.js",
    "js/live.js",
    "js/main.js",
    "js/map.js",
    "js/markdown.js",
    "js/model.js",
    "js/offers.js",
    "js/pickup.js",
    "js/product-setup.js",
    "js/products.js",
    "js/props.js",
    "js/records.js",
    "js/sections.js",
    "js/slash.js",
    "js/summary-cards.js",
    "js/tables.js",
    "js/tandem.js",
    "js/template-info.js",
    "js/templates.js",
    "js/vault.js",
    "js/view.js",
    "notes.css",
    "vendor/codemirror.js",
    "vendor/mermaid.min.js"
  ],
  "aliases": [
    "folio",
    "notebook",
    "notes"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ]
}
