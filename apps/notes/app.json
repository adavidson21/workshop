{
  "manifestVersion": 1,
  "id": "notes",
  "name": "Folio",
  "version": "3.1.0",
  "description": "Folio, your notebook: notes, daily notes, product notes, templates, and Tandem's plans, specs and reviews, as Markdown files. Mermaid diagrams, links and backlinks, tags, search and images.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 45,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "capture": [
    "note"
  ],
  "routes": [
    {
      "path": ":note",
      "title": "Open a note"
    },
    {
      "path": "tandem/:folder/:file",
      "title": "Open a Tandem document"
    },
    {
      "path": "today",
      "title": "Today's note"
    },
    {
      "path": "review",
      "title": "Product notes to review"
    }
  ],
  "commands": [
    {
      "id": "new",
      "title": "New note"
    },
    {
      "id": "search",
      "title": "Search notes"
    },
    {
      "id": "today",
      "title": "Open today's note"
    },
    {
      "id": "diagram",
      "title": "Insert diagram"
    }
  ],
  "handoffs": {
    "sends": [
      "prioritizer",
      "receipts"
    ]
  },
  "data": [
    "taken",
    "handoffs",
    "summary"
  ],
  "files": [
    "notes.css",
    "js/applinks.js",
    "js/daily.js",
    "js/data.js",
    "js/diagram-kits.js",
    "js/diagrams.js",
    "js/edits.js",
    "js/export.js",
    "js/history.js",
    "js/main.js",
    "js/markdown.js",
    "js/model.js",
    "js/offers.js",
    "js/pickup.js",
    "js/products.js",
    "js/records.js",
    "js/sections.js",
    "js/summary-cards.js",
    "js/tandem.js",
    "js/template-info.js",
    "js/templates.js",
    "js/vault.js",
    "js/view.js",
    "icons/app-192.png",
    "icons/app-512.png",
    "icons/app-maskable-512.png",
    "icons/app-touch-180.png",
    "icons/favicon-32.png",
    "icons/favicon.svg",
    "shared/app-sw.js",
    "shared/device-fs.js",
    "shared/fonts/fonts.css",
    "shared/fonts/dm-mono-latin-400-normal.woff2",
    "shared/fonts/dm-mono-latin-500-normal.woff2",
    "shared/fonts/dm-mono-latin-ext-400-normal.woff2",
    "shared/fonts/dm-mono-latin-ext-500-normal.woff2",
    "shared/fonts/figtree-latin-ext-wght-italic.woff2",
    "shared/fonts/figtree-latin-ext-wght-normal.woff2",
    "shared/fonts/figtree-latin-wght-italic.woff2",
    "shared/fonts/figtree-latin-wght-normal.woff2",
    "shared/fonts/gelasio-latin-ext-wght-normal.woff2",
    "shared/fonts/gelasio-latin-wght-normal.woff2",
    "shared/handoffs.js",
    "shared/pair.js",
    "shared/people.js",
    "shared/save-file.js",
    "shared/site.js",
    "shared/standalone-bar.js",
    "shared/summary.js",
    "shared/sw-register.js",
    "shared/teams.js",
    "shared/theme.js",
    "shared/themes.css",
    "shared/ui.css",
    "shared/workshop-sdk.js",
    "vendor/mermaid.min.js"
  ],
  "aliases": [
    "folio",
    "notebook",
    "notes"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ]
}
