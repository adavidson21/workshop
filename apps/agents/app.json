{
  "manifestVersion": 1,
  "id": "agents",
  "name": "Dispatch",
  "version": "2.1.0",
  "description": "Work items, the opencode agents working on them, and first-pass PR reviews.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 20,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "routes": [
    {
      "path": ":id",
      "title": "Show a work item"
    },
    {
      "path": "hub/:text",
      "title": "Ask the hub"
    },
    {
      "path": "chat",
      "title": "Chat with Tandem"
    }
  ],
  "data": [
    "handoffs",
    "summary"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    },
    {
      "id": "ado",
      "required": false
    }
  ],
  "handoffs": {
    "sends": [
      "prioritizer",
      "receipts",
      "notes",
      "runway",
      "slate"
    ]
  },
  "aliases": [
    "dispatch",
    "agents",
    "hub"
  ],
  "commands": [
    {
      "id": "start",
      "title": "Start work"
    },
    {
      "id": "pr-review",
      "title": "Review a pull request"
    },
    {
      "id": "refresh",
      "title": "Refresh work items"
    },
    {
      "id": "repo",
      "title": "Add a repo"
    },
    {
      "id": "project",
      "title": "New project"
    }
  ],
  "files": [
