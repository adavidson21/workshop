{
  "apps": [
    {
      "id": "prioritizer",
      "site": "https://docket.alexisdavidson.org",
      "repo": "adavidson21/docket",
      "binding": "DOCKET",
      "manifest": {
        "manifestVersion": 1,
        "id": "prioritizer",
        "name": "Docket",
        "version": "4.4.0",
        "description": "Decide what to work on next.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 10,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "routes": [
          {
            "path": "task/:id",
            "title": "Open a task"
          }
        ],
        "connectors": [
          {
            "id": "ado",
            "required": false
          },
          {
            "id": "opencode",
            "required": false
          }
        ],
        "commands": [
          {
            "id": "add-task",
            "title": "Add a task",
            "route": ""
          },
          {
            "id": "sync-ado",
            "title": "Sync with Azure DevOps"
          },
          {
            "id": "shortcuts",
            "title": "Docket keyboard shortcuts"
          }
        ],
        "files": [
          "app.css",
          "icons/app-192.png",
          "icons/app-512.png",
          "icons/app-maskable-512.png",
          "icons/app-touch-180.png",
          "icons/favicon-32.png",
          "icons/favicon.svg",
          "js/actions.js",
          "js/ado.js",
          "js/app-banner.js",
          "js/command-bar.js",
          "js/constants.js",
          "js/drag-drop.js",
          "js/drawer.js",
          "js/eng.js",
          "js/events.js",
          "js/excel.js",
          "js/kv.js",
          "js/main.js",
          "js/model.js",
          "js/native.js",
          "js/overlays.js",
          "js/people.js",
          "js/quick-add.js",
          "js/render.js",
          "js/reports.js",
          "js/state.js",
          "js/storage.js",
          "js/store-format.js",
          "js/store.js",
          "js/util.js",
          "js/views.js",
          "js/ws.js",
          "shared/device-fs.js",
          "shared/fonts/fonts.css",
          "shared/fonts/inter-latin-ext-wght-normal.woff2",
          "shared/fonts/inter-latin-wght-normal.woff2",
          "shared/fonts/jetbrains-mono-latin-ext-wght-normal.woff2",
          "shared/fonts/jetbrains-mono-latin-wght-normal.woff2",
          "shared/fonts/source-serif-4-latin-ext-opsz-normal.woff2",
          "shared/fonts/source-serif-4-latin-opsz-normal.woff2",
          "shared/save-file.js",
          "shared/standalone-bar.js",
          "shared/sw-register.js",
          "shared/theme.js",
          "shared/themes.css",
          "shared/ui.css",
          "shared/vendor/xlsx.full.min.js",
          "shared/workshop-sdk.js"
        ]
      }
    }
  ]
}
