        "connectors": [
          {
            "id": "opencode",
            "required": false
          }
        ],
        "capture": [
          "receipt"
        ],
        "aliases": [
          "rapport",
          "receipts",
          {
            "name": "1:1s",
            "path": "1on1s"
          },
          {
            "name": "1:1",
            "path": "1on1s"
          },
          {
            "name": "oneonones",
            "path": "1on1s"
          },
          {
            "name": "one-on-ones",
            "path": "1on1s"
          },
          {
            "name": "goals",
            "path": "goals"
          },
          {
            "name": "okrs",
            "path": "goals"
          }
