          "shared/fonts/fonts.css",
          "shared/fonts/gelasio-latin-ext-wght-normal.woff2",
          "shared/fonts/gelasio-latin-wght-normal.woff2",
          "shared/handoffs.js",
          "shared/pair.js",
          "shared/people.js",
