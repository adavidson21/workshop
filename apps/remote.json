          },
          {
            "path": "goals",
            "title": "Goals for this quarter"
          },
          {
            "path": "goals/:quarter",
            "title": "Goals for a quarter"
          },
          {
            "path": "goals/:quarter/:owner",
            "title": "Goals: the team's or one report's doc"
          },
          {
            "path": "up",
            "title": "Upward"
          },
          {
            "path": "review",
            "title": "Build a review"
          },
          {
            "path": "settings",
            "title": "Rapport settings"
          }
        ],
        "connectors": [
          {
            "id": "opencode",
            "required": false
          }
        ],
        "capture": [
          "receipt"
        ],
        "aliases": [
          "rapport",
          "receipts",
          {
            "name": "1:1s",
            "path": "1on1s"
          },
          {
            "name": "1:1",
            "path": "1on1s"
          },
          {
            "name": "oneonones",
            "path": "1on1s"
          },
          {
            "name": "one-on-ones",
            "path": "1on1s"
          },
          {
            "name": "goals",
            "path": "goals"
          },
          {
            "name": "okrs",
            "path": "goals"
          }
        ],
        "data": [
          "config",
          "entries",
          "people",
          "summary"
        ],
        "commands": [
          {
            "id": "new",
            "title": "Add a receipt",
            "route": "me"
          },
          {
            "id": "prep",
            "title": "Prep a 1:1",
            "route": "1on1s"
          },
          {
            "id": "review",
            "title": "Build a review",
            "route": "review"
          },
          {
            "id": "goals",
            "title": "Open goals",
            "route": "goals"
          }
        ],
