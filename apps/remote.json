{
  "apps": [
    {
      "id": "prioritizer",
      "site": "https://docket.alexisdavidson.org",
      "repo": "adavidson21/docket",
      "binding": "DOCKET",
      "manifest": {
        "manifestVersion": 1,
        "id": "prioritizer",
        "name": "Docket",
        "version": "5.7.0",
        "description": "Decide what to work on next, and plan your day around it.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 10,
        "background": true,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "routes": [
          {
            "path": "task/:id",
            "title": "Open a task"
          },
          {
            "path": "today",
            "title": "Today"
          },
          {
            "path": "day/:date",
            "title": "Plan a day"
          },
          {
            "path": "triage",
            "title": "Triage"
          },
          {
            "path": "prioritize",
            "title": "Prioritize"
          },
          {
            "path": "people",
            "title": "People"
          },
          {
            "path": "shutdown",
            "title": "Wrap up the day"
          }
        ],
        "connectors": [
          {
            "id": "ado",
            "required": false
          },
          {
            "id": "opencode",
            "required": false
          }
        ],
        "handoffs": {
          "sends": [
            "receipts",
            "notes"
          ]
        },
        "capture": [
          "task",
          "waiting"
        ],
        "aliases": [
          "docket",
          "tasks",
          "board",
          {
            "name": "today",
            "path": "today"
          },
          {
            "name": "triage",
            "path": "triage"
          }
        ],
        "commands": [
          {
            "id": "add-task",
            "title": "Add a task",
            "route": ""
          },
          {
            "id": "start-next",
            "title": "Start next task",
            "route": ""
          },
          {
            "id": "open-today",
            "title": "Today's list",
            "route": "today"
          },
          {
            "id": "plan-day",
            "title": "Plan today",
            "route": "day/today"
          },
          {
            "id": "triage",
            "title": "Triage",
            "route": "triage"
          },
          {
            "id": "shutdown-day",
            "title": "Wrap up the day"
