{
  "manifestVersion": 1,
  "id": "people",
  "name": "People",
  "version": "5.1.0",
  "description": "Your private notebook about the people you work with, next to Lattice: one People list, one Log box, and a page per person with their 1:1, Log, goals and review.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 30,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "routes": [
    {
      "path": "people",
      "title": "People"
    },
    {
      "path": "me",
      "title": "My Log"
    },
    {
      "path": "me/review",
      "title": "My review"
    },
    {
      "path": "p/:id",
      "title": "A person"
    },
    {
      "path": "p/:id/:tab",
      "title": "A person: 1:1, Log, Goals or Review"
    },
    {
      "path": "p/:id/goals/:quarter",
      "title": "A report's goals for a quarter"
    },
    {
      "path": "o/:id",
      "title": "A 1:1 with someone not in People"
    },
    {
      "path": "up",
      "title": "Your manager's Log"
    },
    {
      "path": "team",
      "title": "My team's goals"
    },
    {
      "path": "team/:quarter",
      "title": "My team's goals for a quarter"
    },
    {
      "path": "team/:quarter/team",
      "title": "The team's goals doc"
    },
    {
      "path": "1on1s",
      "title": "People (old address)"
    },
    {
      "path": "1on1s/:id",
      "title": "A 1:1 (old address)"
    },
    {
      "path": "goals",
      "title": "My team's goals (old address)"
    },
    {
      "path": "goals/:quarter/:owner",
      "title": "A goals doc (old address)"
    },
    {
      "path": "review",
      "title": "My review (old address)"
    },
    {
      "path": "settings",
      "title": "People's settings, in Settings"
    }
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ],
  "capture": [
    "receipt"
  ],
  "aliases": [
    "rapport",
    "receipts",
    {
      "name": "1:1s",
      "path": "people"
    },
    {
      "name": "1:1",
      "path": "people"
    },
    {
      "name": "oneonones",
      "path": "people"
    },
    {
      "name": "one-on-ones",
      "path": "people"
    },
    {
      "name": "goals",
      "path": "team"
    },
    {
      "name": "okrs",
      "path": "team"
    }
  ],
  "data": [
    "config",
    "entries",
    "people",
    "summary",
    "handoffs"
  ],
  "handoffs": {
    "sends": [
      "tasks"
    ]
  },
  "commands": [
    {
      "id": "new",
      "title": "Log a receipt",
      "route": "people"
    },
    {
      "id": "prep",
      "title": "Prep a 1:1",
      "route": "people"
    },
    {
      "id": "review",
      "title": "Build my review",
      "route": "me/review"
    },
    {
      "id": "goals",
      "title": "Open team goals",
      "route": "team"
    }
  ],
  "files": [
    "app.css",
    "js/goals/model.js",
    "js/goals/page.js",
    "js/goals/view.js",
    "js/lattice.js",
    "js/main.js",
    "js/markdown.js",
    "js/oneonones/data.js",
    "js/oneonones/model.js",
    "js/oneonones/page.js",
    "js/oneonones/view.js",
    "js/state.js"
  ],
  "privateFiles": true,
  "settings": [
    {
      "id": "cycleStart",
      "type": "date",
      "title": "Review cycle starts",
      "description": "The first day your next review covers. People's default period everywhere.",
      "default": ""
    },
    {
      "id": "cycleEnd",
      "type": "date",
      "title": "Review cycle ends",
      "default": ""
    },
    {
      "id": "sections",
      "type": "lines",
      "title": "Review sections",
      "description": "Matching your review form in Lattice. Renaming one does not retag old receipts.",
      "default": [
        "Results",
        "Craft",
        "Ownership",
        "Collaboration",
        "Communication",
        "Leadership",
        "Growth"
      ]
    },
    {
      "id": "staleDays",
      "type": "number",
      "title": "Flag a report after (days)",
      "description": "Highlights a report on People when nothing is logged about them for this many days.",
      "default": 30,
      "min": 1,
      "max": 365
    },
    {
      "id": "tandem",
      "type": "boolean",
      "title": "Tandem in 1:1s",
      "description": "Draft talking points with Tandem, and let Wrap up ask it to read the note. Needs the opencode connector. Off: nothing is sent to opencode.",
      "default": true
    }
  ]
}
