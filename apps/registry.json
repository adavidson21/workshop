            "id": "sort-one-by-one",
            "title": "Card sort",
            "route": "inbox"
          },
          {
            "id": "shutdown-day",
            "title": "Wrap up the day"
          },
          {
            "id": "sync-ado",
            "title": "Sync work items (Azure DevOps, GitHub)"
          },
          {
            "id": "shortcuts",
            "title": "Docket keyboard shortcuts"
          }
        ],
        "settings": [
          {
            "id": "sprints",
            "type": "boolean",
            "title": "Use sprints",
            "description": "Day counts sprint days and adds every-sprint tasks. Off: Day templates go by weekday and every-sprint tasks are paused.",
            "default": true
          },
          {
            "id": "personalTasks",
            "type": "boolean",
            "title": "Personal tasks",
            "description": "Off: Docket is your agent queue (what Tandem's builds need from you, from Loom) and PR reviews; your own tasks are hidden, not deleted. On: everything shows, as before.",
            "default": false
          }
