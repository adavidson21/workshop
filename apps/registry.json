{
  "apps": [
    {
      "base": "/apps/home/",
      "manifest": {
        "manifestVersion": 1,
        "id": "home",
        "name": "Home",
        "version": "1.0.0",
        "description": "Your day at a glance: Today, triage, what's next, your people and your agents.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 0,
        "home": true,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "connectors": [
          {
            "id": "opencode",
            "required": false
          }
        ],
        "data": [
          "profile"
        ],
        "files": [
          "home.css",
          "js/main.js",
          "js/view.js"
        ]
      }
    },
    {
      "base": "/apps/prioritizer/",
      "manifest": {
        "manifestVersion": 1,
        "id": "prioritizer",
        "name": "Docket",
        "version": "4.3.0",
        "description": "Decide what to work on next.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 10,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "routes": [
          {
            "path": "task/:id",
            "title": "Open a task"
          }
        ],
        "connectors": [
          {
            "id": "ado",
            "required": false
          },
          {
            "id": "opencode",
            "required": false
          }
        ],
        "commands": [
          {
            "id": "add-task",
            "title": "Add a task",
            "route": ""
          },
          {
            "id": "sync-ado",
            "title": "Sync with Azure DevOps"
          },
          {
            "id": "shortcuts",
            "title": "Docket keyboard shortcuts"
          }
        ],
        "files": [
          "app.css",
          "js/actions.js",
          "js/ado.js",
          "js/app-banner.js",
          "js/command-bar.js",
          "js/constants.js",
          "js/drag-drop.js",
          "js/drawer.js",
          "js/eng.js",
          "js/events.js",
          "js/excel.js",
          "js/kv.js",
          "js/main.js",
          "js/model.js",
          "js/overlays.js",
          "js/people.js",
          "js/quick-add.js",
          "js/render.js",
          "js/reports.js",
          "js/state.js",
          "js/storage.js",
          "js/store-format.js",
          "js/store.js",
          "js/util.js",
          "js/views.js",
          "js/ws.js"
        ]
      }
    },
    {
      "base": "/apps/agents/",
      "manifest": {
        "manifestVersion": 1,
        "id": "agents",
        "name": "Dispatch",
        "version": "1.0.0",
        "description": "The front end for Tandem: your work items and the opencode agents working on them.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 20,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "routes": [
          {
            "path": ":id",
            "title": "Show a work item"
          }
        ],
        "connectors": [
          {
            "id": "opencode",
            "required": false
          }
        ],
        "commands": [
          {
            "id": "refresh",
            "title": "Refresh work items"
          }
        ],
        "files": [
          "agents.css",
          "js/main.js",
          "js/state.js",
          "js/view.js"
        ]
      }
    },
    {
      "base": "/apps/settings/",
      "manifest": {
        "manifestVersion": 1,
        "id": "settings",
        "name": "Settings",
        "version": "1.0.0",
        "description": "Workshop's settings, connectors, and moving your data.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 90,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "files": [
          "settings.css",
          "js/settings.js",
          "js/forms.js"
        ]
      }
    }
  ]
}
