          {
            "id": "start-next",
            "title": "Start next task",
            "route": ""
          },
          {
            "id": "stuck",
            "title": "Stuck on my task"
          },
          {
            "id": "open-today",
            "title": "Today's list",
            "route": "today"
          },
          {
            "id": "plan-day",
            "title": "Plan today",
            "route": "day/today"
          },
          {
            "id": "plan-week",
            "title": "Plan the week",
            "route": "plan-week"
          },
