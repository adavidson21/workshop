{
  "apps": [
    {
      "base": "/apps/home/",
      "manifest": {
        "manifestVersion": 1,
        "id": "home",
        "name": "Needs you",
        "version": "5.2.0",
        "description": "What needs you across apps, what is coming up and what you finished this week. Opens from the top bar on every app.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 0,
        "panel": true,
        "background": true,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "connectors": [
          {
            "id": "opencode",
            "required": false
          }
        ],
        "handoffs": {
          "sends": [
            "prioritizer",
            "receipts",
            "notes",
            "runway",
            "slate"
          ]
        },
        "data": [
          "profile",
          "setup",
          "handoffs"
        ],
        "files": [
          "home.css",
          "js/data.js",
          "js/main.js",
          "js/setup.js",
          "js/view.js"
        ]
      }
    },
    {
