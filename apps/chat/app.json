{
  "manifestVersion": 1,
  "id": "chat",
  "name": "Chat",
  "version": "4.1.0",
  "rail": false,
  "description": "opencode with a better screen: any agent and model, /commands, @files, pictures and PDFs, a context meter, and a Terminal, Files, Changes and a Second chat beside it.",
  "icon": "icon.svg",
