{
  "manifestVersion": 1,
  "id": "chat",
  "name": "Chat",
  "version": "2.1.0",
  "description": "opencode with a better screen: any agent and model, /commands, @files, !shell, diffs and permission prompts. Hub asks Tandem or captures; Rewrite a draft uses your voice.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 16,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ],
  "aliases": [
    "ask",
    "chat",
    "hub",
    "opencode",
    "tandem"
  ],
  "handoffs": {
    "sends": [
      "prioritizer",
      "receipts",
      "notes",
      "runway",
      "slate"
    ]
  },
  "routes": [
    {
      "path": "rewrite",
      "title": "Rewrite a draft"
    },
    {
      "path": "hub/:text",
      "title": "Ask or capture"
    },
    {
      "path": "chat/:session",
      "title": "Open a chat"
    },
    {
      "path": ":session",
      "title": "Open a chat"
    }
  ],
  "commands": [
    {
      "id": "new",
      "title": "New chat"
    },
    {
      "id": "rewrite",
      "title": "Rewrite a draft"
    }
  ],
  "data": [
    "handoffs",
    "writing-feedback"
  ],
  "files": [
    "chat.css",
    "js/main.js",
    "js/chat.js",
    "js/hub.js",
    "js/hub-model.js",
    "js/thread.js",
    "js/rewrite.js",
    "js/parts.js",
    "js/md.js"
  ]
}
