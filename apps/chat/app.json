    "js/main.js",
    "js/chat.js",
    "js/hub.js",
    "js/hub-model.js",
    "js/thread.js",
    "js/rewrite.js",
    "js/parts.js",
    "js/md.js",
    "js/sources.js",
    "js/bench.js",
    "js/terminal.js",
    "js/files.js",
    "js/side.js",
    "js/changes.js",
    "js/split.js",
    "js/images.js",
    "vendor/xterm/xterm.mjs",
    "vendor/xterm/addon-fit.mjs",
    "vendor/xterm/xterm.css"
  ]
}
