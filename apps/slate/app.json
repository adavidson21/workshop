{
  "manifestVersion": 1,
  "id": "slate",
  "name": "Loom",
  "version": "6.9.0",
  "description": "Tandem's runs on a floor: a code line and a research line of stations, or a list, plus Health. Drop in a story, an error log, a question or a hand-off; a card stops only when it needs you.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 15,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    },
    {
      "id": "github",
      "required": false
    },
    {
      "id": "opencode",
      "required": false
    }
  ],
  "capture": [
    "request"
  ],
  "aliases": [
    "loom",
    "dispatch",
    "backlog",
    "requests",
    "enhancements",
    {
      "name": "health",
      "path": "health"
    },
    {
      "name": "sprints",
      "path": "sprints"
    },
    {
      "name": "reports",
      "path": "health/reports"
    },
    {
      "name": "reviews",
      "path": "reviews"
    },
    {
      "name": "lanes",
      "path": "lanes"
    }
  ],
  "handoffs": {
    "sends": [
      "runway",
      "prioritizer",
      "notes",
      "receipts"
    ]
  },
  "settings": [
    {
      "id": "nudge",
      "type": "boolean",
      "title": "Nudge stalled hand-offs",
      "description": "A hand-off with no movement in 3 working days shows in the Inbox until you follow up.",
      "default": true
    }
  ],
  "routes": [
    {
      "path": "item/:id",
      "title": "Open an item"
    },
    {
      "path": "health",
      "title": "Team health"
    },
    {
      "path": "health/reports",
      "title": "Team reports (in Health)"
    },
    {
      "path": "sprints",
      "title": "Sprints (in Health)"
    },
    {
      "path": "lanes",
      "title": "Floor: start work, and what waits on you"
    },
    {
      "path": "chat",
      "title": "Chat with Tandem (opens Chat)"
    },
    {
      "path": "hub/:text",
      "title": "Ask the hub (opens Chat)"
    },
    {
      "path": "reviews",
      "title": "PR reviews (the floor's Review card)"
    },
    {
      "path": "start/:flow",
      "title": "Start work: the drop box, its kind picked"
    },
    {
      "path": "start/:flow/:text",
      "title": "Start work: the drop box, filled in"
    },
    {
      "path": ":id",
      "title": "Show a run or a review"
    }
  ],
  "commands": [
    {
      "id": "start",
      "title": "Start work (the drop box)"
    },
    {
      "id": "pr-review",
      "title": "Review a pull request"
    },
    {
      "id": "refresh",
      "title": "Refresh from ADO and Tandem"
    },
    {
      "id": "health",
      "title": "Team health",
      "route": "health"
    },
    {
      "id": "sprints",
      "title": "Plan sprints",
      "route": "sprints"
    },
    {
      "id": "team-reports",
      "title": "Team reports",
      "route": "health/reports"
    },
    {
      "id": "repo",
      "title": "Add a repo"
    },
    {
      "id": "project",
      "title": "New project"
    }
  ],
  "data": [
    "items",
    "handoffs",
    "summary"
  ],
  "privateFiles": [
    "reports"
  ],
  "files": [
    "slate.css",
    "js/main.js",
    "js/data.js",
    "js/model.js",
    "js/view.js",
    "js/health.js",
    "js/tandem-health.js",
    "js/reports/index.js",
    "js/reports/model.js",
    "js/reports/view.js",
    "dispatch.css",
    "js/dispatch/main.js",
    "js/dispatch/doc.js",
    "js/dispatch/state.js",
    "js/dispatch/view.js",
    "js/dispatch/projects.js",
    "js/dispatch/pages.js",
    "js/dispatch/local.js",
    "js/dispatch/pr-reviews.js",
    "review.html",
    "review.css",
    "js/dispatch/review.js",
    "js/dispatch/review-state.js",
    "js/dispatch/review-view.js",
    "js/dispatch/review-api.js",
    "js/dispatch/review-fixture.js",
    "js/dispatch/summary.js",
    "js/dispatch/digest.js",
    "js/dispatch/slate-handoff.js",
    "js/dispatch/flows.js",
    "js/dispatch/lanes.js",
    "js/dispatch/noticed.js",
    "js/dispatch/factory.js",
    "js/dispatch/start-prefill.js",
    "js/loom.js",
    "js/app.js",
    "loom.css"
  ]
}
