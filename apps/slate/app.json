{
  "manifestVersion": 1,
  "id": "slate",
  "name": "Slate",
  "version": "1.7.0",
  "description": "Your team's backlog from request to who builds it, with roadmaps, sprints and team health. Tandem does the legwork; you decide.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 15,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    },
    {
      "id": "opencode",
      "required": false
    }
  ],
  "aliases": [
    "backlog",
    "requests",
    "enhancements",
    {
      "name": "health",
      "path": "health"
    },
    {
      "name": "sprints",
      "path": "sprints"
    }
  ],
  "handoffs": {
    "sends": [
      "runway",
      "prioritizer",
      "notes",
      "receipts"
    ]
  },
  "routes": [
    {
      "path": "item/:id",
      "title": "Open an item"
    },
    {
      "path": "roadmaps",
      "title": "Roadmaps"
    },
    {
      "path": "health",
      "title": "Team health"
    },
    {
      "path": "sprints",
      "title": "Sprints"
    }
  ],
  "commands": [
    {
      "id": "new",
      "title": "New request",
      "route": ""
    },
    {
      "id": "new-idea",
      "title": "New idea (shape it with an agent)",
      "route": ""
    },
    {
      "id": "refresh",
      "title": "Refresh from ADO and Tandem"
    },
    {
      "id": "roadmaps",
      "title": "Open roadmaps",
      "route": "roadmaps"
    },
    {
      "id": "new-roadmap",
      "title": "New roadmap",
      "route": "roadmaps"
    },
    {
      "id": "health",
      "title": "Team health",
      "route": "health"
    },
    {
      "id": "sprints",
      "title": "Plan sprints",
      "route": "sprints"
    }
  ],
  "data": [
    "items",
    "handoffs",
    "summary"
  ],
  "files": [
    "slate.css",
    "js/main.js",
    "js/data.js",
    "js/model.js",
    "js/view.js",
    "js/host.js",
    "js/health.js"
  ],
  "hosts": [
    {
      "app": "runway",
      "path": "roadmaps"
    }
  ]
}
