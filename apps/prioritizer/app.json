{
  "manifestVersion": 1,
  "id": "prioritizer",
  "name": "Docket",
  "version": "4.14.1",
  "description": "Decide what to work on next, and plan your day around it.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 10,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "routes": [
    {
      "path": "task/:id",
      "title": "Open a task"
    },
    {
      "path": "today",
      "title": "Today"
    },
    {
      "path": "day/:date",
      "title": "Plan a day"
    },
    {
      "path": "triage",
      "title": "Triage"
    },
    {
      "path": "prioritize",
      "title": "Prioritize"
    },
    {
      "path": "people",
      "title": "People"
    },
    {
      "path": "shutdown",
      "title": "Wrap up the day"
    }
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    },
    {
      "id": "opencode",
      "required": false
    }
  ],
  "commands": [
    {
      "id": "add-task",
      "title": "Add a task",
      "route": ""
    },
    {
      "id": "start-next",
      "title": "Start next task",
      "route": ""
    },
    {
      "id": "open-today",
      "title": "Today's list",
      "route": "today"
    },
    {
      "id": "plan-day",
      "title": "Plan today",
      "route": "day/today"
    },
    {
      "id": "triage",
      "title": "Triage",
      "route": "triage"
    },
    {
      "id": "shutdown-day",
      "title": "Wrap up the day"
    },
    {
      "id": "sync-ado",
      "title": "Sync with Azure DevOps"
    },
    {
      "id": "shortcuts",
      "title": "Docket keyboard shortcuts"
    }
  ],
  "files": [
    "app.css",
    "icons/app-192.png",
    "icons/app-512.png",
    "icons/app-maskable-512.png",
    "icons/app-touch-180.png",
    "icons/favicon-32.png",
    "icons/favicon.svg",
    "js/actions.js",
    "js/ado.js",
    "js/app-banner.js",
    "js/command-bar.js",
    "js/connect.js",
    "js/constants.js",
    "js/day-view.js",
    "js/dayplan-format.js",
    "js/dayplan-model.js",
    "js/dayplan.js",
    "js/directory-model.js",
    "js/directory.js",
    "js/drag-drop.js",
    "js/drawer.js",
    "js/eng.js",
    "js/events.js",
    "js/excel.js",
    "js/focus-format.js",
    "js/focus-model.js",
    "js/focus.js",
    "js/kv.js",
    "js/main.js",
    "js/model.js",
    "js/native.js",
    "js/offers-model.js",
    "js/offers.js",
    "js/onboarding.js",
    "js/overlays.js",
    "js/people.js",
    "js/quick-add.js",
    "js/render.js",
    "js/reports.js",
    "js/state.js",
    "js/storage.js",
    "js/store-format.js",
    "js/store.js",
    "js/util.js",
    "js/views.js",
    "js/ws.js",
    "shared/device-fs.js",
    "shared/fonts/fonts.css",
    "shared/fonts/inter-latin-ext-wght-normal.woff2",
    "shared/fonts/inter-latin-wght-normal.woff2",
    "shared/fonts/jetbrains-mono-latin-ext-wght-normal.woff2",
    "shared/fonts/jetbrains-mono-latin-wght-normal.woff2",
    "shared/fonts/source-serif-4-latin-ext-opsz-normal.woff2",
    "shared/fonts/source-serif-4-latin-opsz-normal.woff2",
    "shared/pair.js",
    "shared/save-file.js",
    "shared/standalone-bar.js",
    "shared/sw-register.js",
    "shared/theme.js",
    "shared/themes.css",
    "shared/ui.css",
    "shared/vendor/xlsx.full.min.js",
    "shared/workshop-sdk.js"
  ]
}
