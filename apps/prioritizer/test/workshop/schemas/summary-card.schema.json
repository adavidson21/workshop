{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A summary card: one item of <app>.summary v1",
  "description": "What an app publishes about itself for other apps to show. See summaries.md.",
  "type": "object",
  "required": [
    "id",
    "updatedAt",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/msTime"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "count, list, targets, board, day, people or held. Readers ignore kinds they do not know."
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "route": {
      "type": "string",
      "maxLength": 200
    },
    "capture": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "rows": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object"
      }
    },
    "days": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/day"
      },
      "additionalProperties": {
        "type": "object"
      },
      "description": "Keyed by YYYY-MM-DD: today and the next 6 days."
    },
    "upNext": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ]
      }
    },
    "team": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "name",
          "open",
          "waiting"
        ]
      }
    },
    "block": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "held cards: the held span, the date and HH:MM it started (focus.md)."
    },
    "label": {
      "type": "string",
      "maxLength": 120
    }
  },
  "$defs": {
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "anyOf": [
    {
      "properties": {
        "kind": {
          "const": "count"
        }
      },
      "required": [
        "title",
        "count"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "list"
        }
      },
      "required": [
        "title",
        "rows"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "targets"
        }
      },
      "required": [
        "capture",
        "rows"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "board"
        }
      },
      "required": [
        "days"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "day"
        }
      },
      "required": [
        "days"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "people"
        }
      },
      "required": [
        "rows"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "held"
        }
      },
      "required": [
        "block",
        "count",
        "label"
      ]
    },
    {
      "properties": {
        "kind": {
          "not": {
            "enum": [
              "count",
              "list",
              "targets",
              "board",
              "day",
              "people",
              "held"
            ]
          }
        }
      }
    }
  ]
}
