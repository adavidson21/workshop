{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docket day plan: an every-sprint task (an item of prioritizer.dayplan/recurring v1)",
  "type": "object",
  "required": [
    "id",
    "title",
    "dueDay",
    "last",
    "value",
    "effort",
    "listId",
    "paused",
    "made"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "dueDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "description": "Sprint day it is due on (the last working day if the sprint is shorter)."
    },
    "last": {
      "type": "boolean",
      "description": "Due on the last working day instead of dueDay."
    },
    "value": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "effort": {
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "listId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "paused": {
      "type": "boolean"
    },
    "made": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "description": "Start dates of sprints that already got their task."
    },
    "planKind": {
      "type": "string",
      "maxLength": 40,
      "description": "Automatic Day planning: the block kind its task goes into on its due day; empty means don't plan."
    },
    "from": {
      "type": "object",
      "required": [
        "app"
      ],
      "properties": {
        "app": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "id": {
          "type": "string",
          "maxLength": 200
        }
      },
      "description": "The app (and its record) this item was accepted from, so that app's later offers update it instead of adding another."
    }
  }
}
