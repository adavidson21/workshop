// Cloudflare Worker for docket.alexisdavidson.org: this repo's static files, nothing else.
// Deploy with `npx wrangler deploy`. Workshop (workshop.alexisdavidson.org) shows Docket inside its shell by
// proxying /apps/prioritizer/* to this Worker (a service binding named DOCKET in Workshop's wrangler.jsonc),
// so a deploy here updates both. Keep the name "docket": the binding refers to it.
{
  "name": "docket",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "docket.alexisdavidson.org", "custom_domain": true }
  ]
}
