{
  "manifestVersion": 1,
  "id": "home",
  "name": "Home",
  "version": "1.0.0",
  "description": "Your day at a glance: Today, triage, what's next, your people and your agents.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 0,
  "home": true,
