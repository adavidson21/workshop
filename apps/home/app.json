{
  "manifestVersion": 1,
  "id": "home",
  "name": "Home",
  "version": "3.0.0",
  "description": "Everything at a glance: what needs you across apps, your day in one card, what is coming up and what you finished.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 0,
  "home": true,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ],
  "handoffs": {
    "sends": [
      "prioritizer",
      "receipts",
      "notes",
      "runway",
      "slate"
    ]
  },
  "data": [
    "profile",
    "setup",
    "handoffs"
  ],
  "files": [
    "home.css",
    "js/data.js",
    "js/main.js",
    "js/capture.js",
    "js/setup.js",
    "js/view.js"
  ]
}
