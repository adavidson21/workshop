{
  "manifestVersion": 1,
  "id": "home",
  "name": "Home",
  "version": "2.3.0",
  "description": "Your day at a glance: Docket's Today in counts, what needs you across apps, and Dispatch, with a button for each part of the day.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 0,
  "home": true,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ],
  "handoffs": {
    "sends": [
      "prioritizer",
      "receipts",
      "notes",
      "runway"
    ]
  },
  "data": [
    "profile",
    "setup",
    "handoffs"
  ],
  "files": [
    "home.css",
    "js/data.js",
    "js/main.js",
    "js/capture.js",
    "js/setup.js",
    "js/view.js"
  ]
}
