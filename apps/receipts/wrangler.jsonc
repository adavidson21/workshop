// Cloudflare Worker for receipts.alexisdavidson.org. Deploy with `npx wrangler deploy`.
// The site is this repo's static files; worker/index.js makes apps/receipts/ the whole site.
{
  "name": "receipts",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "receipts.alexisdavidson.org", "custom_domain": true }
  ]
}
