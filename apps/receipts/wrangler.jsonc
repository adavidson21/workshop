// Cloudflare Worker for receipts.alexisdavidson.org: this repo's static files, nothing else.
// Deploy with `npx wrangler deploy` (or Workers Builds from main). Workshop (workshop.alexisdavidson.org) shows
// Rapport inside its shell by proxying /apps/receipts/* to this Worker (a service binding named RECEIPTS in
// Workshop's wrangler.jsonc), so a deploy here updates both. Keep the name "receipts": the binding refers to it.
{
  "name": "receipts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "receipts.alexisdavidson.org", "custom_domain": true }
  ]
}
