{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "receipts.config",
  "description": "People (items) and settings (meta): rubric, roles, categories per role, cycles, nudgeDays, csvColumns. See apps/receipts/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "rev",
    "items",
    "meta"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^receipts\\.config$"
    },
    "version": {
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "updatedAt",
          "name",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "relation": {
            "enum": [
              "self",
              "report",
              "manager"
            ]
          },
          "role": {
            "type": "string",
            "maxLength": 40
          },
          "level": {
            "type": "string",
            "maxLength": 40
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "deleted": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "updatedAt",
        "rubric",
        "cycles"
      ],
      "properties": {
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            }
          }
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "start",
              "end"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "due": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        "nudgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "csvColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
