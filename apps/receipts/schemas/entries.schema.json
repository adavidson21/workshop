{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "receipts.entries/<person>/<yyyy>",
  "description": "One person's entries for one year. Written only by you (and, from V1.1, by importers when you accept a suggestion).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "rev",
    "items"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^receipts\\.entries/[a-z0-9][a-z0-9-]{0,39}/\\d{4}$"
    },
    "version": {
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "updatedAt",
          "date",
          "kind",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "win",
              "growth",
              "concern",
              "feedback",
              "note"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 4000
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
            },
            "maxItems": 3,
            "uniqueItems": true
          },
          "category": {
            "type": "string",
            "maxLength": 200
          },
          "bullet": {
            "type": "string",
            "maxLength": 600
          },
          "impact": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "effort": {
            "anyOf": [
              {
                "enum": [
                  "S",
                  "M",
                  "L"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "strategic": {
            "type": "boolean"
          },
          "riskReduced": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "visibility": {
            "anyOf": [
              {
                "enum": [
                  "Self",
                  "Team",
                  "Org",
                  "Company",
                  "Customer"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 20
          },
          "artifact": {
            "type": "string",
            "maxLength": 100
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 20
          },
          "metric": {
            "type": "string",
            "maxLength": 300
          },
          "metricSource": {
            "type": "string",
            "maxLength": 100
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 20
          },
          "review": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "sourceRef": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "deleted": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
