{
  "manifestVersion": 1,
  "id": "receipts",
  "name": "Rapport",
  "version": "2.0.0",
  "description": "Receipts and 1:1s for you, your reports and your manager: log wins and feedback, prep each 1:1 from what Docket, Rapport and Queue know, and build review drafts by section.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 30,
  "modes": ["local", "hosted", "browser"],
  "routes": [
    {"path": "me", "title": "My receipts"},
    {"path": "team", "title": "Reports"},
    {"path": "team/:id", "title": "A report: 1:1 and receipts"},
    {"path": "1on1s", "title": "1:1s"},
    {"path": "1on1s/settings", "title": "1:1s people and links"},
    {"path": "1on1s/:id", "title": "Prep a 1:1 with a person"},
    {"path": "up", "title": "Upward"},
    {"path": "review", "title": "Build a review"},
    {"path": "settings", "title": "Rapport settings"}
  ],
  "connectors": [
    {"id": "opencode", "required": false}
  ],
  "data": ["entries", "people", "config"],
  "commands": [
    {"id": "new", "title": "Add a receipt", "route": "me"},
    {"id": "prep", "title": "Prep a 1:1", "route": "1on1s"},
    {"id": "review", "title": "Build a review", "route": "review"}
  ],
  "files": ["app.css", "js/main.js", "js/state.js", "js/oneonones/data.js", "js/oneonones/markdown.js", "js/oneonones/model.js", "js/oneonones/page.js", "js/oneonones/view.js"]
}
