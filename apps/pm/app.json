{
  "manifestVersion": 1,
  "id": "pm",
  "name": "Releases",
  "version": "2.0.0",
  "description": "Release health for your products' Epics and Features from ADO, and the sprint's ceremonies. Roadmaps are in Runway.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 42,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "routes": [
    {
      "path": "releases",
      "title": "Release health"
    },
    {
      "path": "releases/:id",
      "title": "Release health of an Epic"
    },
    {
      "path": "cadence",
      "title": "Sprint cadence"
    },
    {
      "path": "settings",
      "title": "Roadmap settings"
    }
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    }
  ],
  "data": [
    "products",
    "cadence",
    "seen",
    "snapshot",
    "handoffs"
  ],
  "commands": [
    {
      "id": "refresh",
      "title": "Refresh release health"
    },
    {
      "id": "scope",
      "title": "Scope new work"
    },
    {
      "id": "cadence",
      "title": "Sprint cadence",
      "route": "cadence"
    }
  ],
  "files": [
    "pm.css",
    "js/main.js",
    "js/data.js",
    "js/model.js",
    "js/view.js"
  ]
}
