{
  "manifestVersion": 1,
  "id": "builds",
  "name": "Builds",
  "version": "6.21.0",
  "description": "Tandem's runs on a floor: a code line and a research line of stations, or a list, plus Health. Drop in a story, an error log, a question or a hand-off; a card stops only when it needs you.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 15,
  "background": true,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    },
    {
      "id": "github",
      "required": false
    },
    {
      "id": "opencode",
      "required": false
    }
  ],
  "capture": [
    "request"
  ],
  "aliases": [
    "loom",
    "slate",
    "dispatch",
    "backlog",
    "requests",
    "enhancements",
    {
      "name": "health",
      "path": "health"
    },
    {
      "name": "sprints",
      "path": "sprints"
    },
    {
      "name": "reports",
      "path": "health/reports"
    },
    {
      "name": "reviews",
      "path": "reviews"
    },
    {
      "name": "lanes",
      "path": "lanes"
    }
  ],
  "handoffs": {
    "sends": [
      "roadmaps",
      "tasks",
      "notes",
      "people"
    ]
  },
  "settings": [
    {
      "id": "nudge",
      "type": "boolean",
      "title": "Nudge stalled hand-offs",
      "description": "A hand-off with no movement in 3 working days shows in the Inbox until you follow up.",
      "default": true
    }
  ],
  "routes": [
    {
      "path": "item/:id",
      "title": "Open an item"
    },
    {
      "path": "health",
      "title": "Team health"
    },
    {
      "path": "health/reports",
      "title": "Team reports (in Health)"
    },
    {
      "path": "sprints",
      "title": "Sprints (in Health)"
    },
    {
      "path": "lanes",
      "title": "Floor: start work, and what waits on you"
    },
    {
      "path": "chat",
      "title": "Chat with Tandem (opens Chat)"
    },
    {
      "path": "hub/:text",
      "title": "Ask the hub (opens Chat)"
    },
    {
      "path": "reviews",
      "title": "PR reviews (the floor's Review card)"
    },
    {
      "path": "start/drop/:text",
      "title": "The drop box, filled in, its kind guessed"
    },
    {
      "path": "start/go/:text",
      "title": "Build with Tandem: the drop box filled in, started once Tandem is ready"
    },
    {
      "path": "start/:flow",
      "title": "Start work: the drop box, its kind picked"
    },
    {
      "path": "start/:flow/:text",
      "title": "Start work: the drop box, filled in"
    },
    {
      "path": ":id",
      "title": "Show a run or a review"
    }
  ],
  "commands": [
    {
      "id": "start",
      "title": "Start work (the drop box)"
    },
    {
      "id": "pr-review",
      "title": "Review a pull request"
    },
    {
      "id": "refresh",
      "title": "Refresh the board"
    },
    {
      "id": "health",
      "title": "Team health",
      "route": "health"
    },
    {
      "id": "sprints",
      "title": "Plan sprints",
      "route": "sprints"
    },
    {
      "id": "team-reports",
      "title": "Team reports",
      "route": "health/reports"
    },
    {
      "id": "repo",
      "title": "Add a repo"
    },
    {
      "id": "project",
      "title": "New project"
    }
  ],
  "data": [
    "items",
    "handoffs",
    "summary",
    "doc-links"
  ],
  "privateFiles": [
    "reports"
  ],
  "files": [
    "builds.css",
    "js/main.js",
    "js/data.js",
    "js/model.js",
    "js/view.js",
    "js/health.js",
    "js/tandem-health.js",
    "js/reports/index.js",
    "js/reports/model.js",
    "js/reports/view.js",
    "runs.css",
    "js/runs/main.js",
    "js/runs/doc.js",
    "js/runs/state.js",
    "js/runs/view.js",
    "js/runs/projects.js",
    "js/runs/pages.js",
    "js/runs/local.js",
    "js/runs/pr-reviews.js",
    "review.html",
    "review.css",
    "js/runs/review.js",
    "js/runs/review-state.js",
    "js/runs/review-view.js",
    "js/runs/review-api.js",
    "js/runs/review-fixture.js",
    "js/runs/summary.js",
    "js/runs/digest.js",
    "js/runs/builds-handoff.js",
    "js/runs/flows.js",
    "js/runs/lanes.js",
    "js/runs/noticed.js",
    "js/runs/factory.js",
    "js/runs/start-prefill.js",
    "js/board.js",
    "js/app.js",
    "board.css",
    "js/runs/docs.js"
  ]
}
