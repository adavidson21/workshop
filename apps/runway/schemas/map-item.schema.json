{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runway: a roadmap item (an item of runway.maps/<id> v1 with kind item)",
  "description": "start and end are inclusive dates. An item with no start may have a size instead; it then starts after its dependsOn items end (or at the roadmap's first period). Neither means unscheduled.",
  "type": "object",
  "required": ["id", "kind", "lane", "order", "title", "start", "end", "size", "milestone", "status", "color", "notes", "dependsOn", "afterMissing"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "updatedAt": {"type": "integer", "minimum": 0},
    "kind": {"const": "item"},
    "lane": {"anyOf": [{"type": "null"}, {"type": "string"}], "description": "A lane id, or null for no lane."},
    "order": {"type": "number", "description": "Position in its lane, for the outline."},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "start": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
    "end": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
    "size": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["n", "unit"], "additionalProperties": false, "properties": {
      "n": {"type": "integer", "minimum": 1, "maximum": 500},
      "unit": {"enum": ["day", "week", "sprint", "month", "quarter"]}}}]},
    "milestone": {"type": "boolean", "description": "One date: start and end are the same."},
    "status": {"enum": ["planned", "active", "done", "at risk", "cut"]},
    "color": {"enum": ["", "slate", "teal", "green", "amber", "red", "purple", "gray"], "description": "Empty uses the lane's color."},
    "notes": {"type": "string", "maxLength": 4000, "description": "The description: what the item delivers. Shown under the timeline and in exports."},
    "dependsOn": {"type": "array", "items": {"type": "string"}},
    "afterMissing": {"type": "array", "items": {"type": "string"}, "description": "Names in the outline's after: that match no item, kept so the text round trips."},
    "ado": {"type": "object", "required": ["id"], "description": "Phase 2: the linked work item.", "properties": {
      "id": {"type": "integer"}, "connection": {"type": "string"}, "rev": {"type": "integer"}}}
  }
}
