{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runway: an idea waiting for a roadmap (an item of runway.pending v1)",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "updatedAt": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "notes": {"type": "string", "maxLength": 4000, "description": "Lines after the first of what was captured."},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The day it was captured."},
    "from": {"type": "string", "description": "The app it was captured in, by name."}
  }
}
