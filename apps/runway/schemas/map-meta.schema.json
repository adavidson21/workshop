{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runway: a roadmap's settings (meta of runway.maps/<id> v1)",
  "type": "object",
  "required": ["title", "scale", "origin", "sprint", "range", "hidden"],
  "properties": {
    "updatedAt": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "scale": {"enum": ["week", "sprint", "month", "quarter"]},
    "origin": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Where S1, W1 and year-less months count from."},
    "sprint": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["anchor", "weeks"], "properties": {
      "anchor": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The first day of any sprint."},
      "weeks": {"type": "integer", "minimum": 1, "maximum": 8}}}]},
    "range": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["from", "to"], "properties": {
      "from": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "to": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}], "description": "Dates shown; null fits the items."},
    "hidden": {"type": "array", "items": {"type": "string"}, "description": "Folded lanes. Left out of image exports."},
    "goals": {"type": "array", "description": "Goals per period: the goal belongs to the period of the map's scale that holds date.", "items": {"type": "object", "required": ["date", "text"], "properties": {
      "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "text": {"type": "string", "minLength": 1, "maxLength": 300}}}},
    "ado": {"type": "object", "required": ["mode", "areas"], "description": "Set when the roadmap follows Azure DevOps (optional).", "properties": {
      "mode": {"enum": ["live", "linked"], "description": "live: rebuilt from ADO on every refresh, items read only. linked: imported items you edit; refresh never overwrites your edits."},
      "areas": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string"}},
      "types": {"type": "array", "items": {"enum": ["Epic", "Feature"]}},
      "lanes": {"enum": ["area", "epic"]},
      "connection": {"type": "string", "maxLength": 40},
      "includeClosed": {"type": "boolean"},
      "fetchedAt": {"type": "string"},
      "total": {"type": "integer"},
      "truncated": {"type": "boolean"}}}
  }
}
