{
  "manifestVersion": 1,
  "id": "runway",
  "name": "Runway",
  "version": "1.11.0",
  "description": "Team and project roadmaps: type an outline, drag the timeline, export an image or Markdown. Optionally from Azure DevOps, with team reports.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 50,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    }
  ],
  "capture": [
    "idea"
  ],
  "aliases": [
    "roadmap",
    "roadmaps",
    {
      "name": "reports",
      "path": "reports"
    }
  ],
  "routes": [
    {
      "path": "reports",
      "title": "Team reports"
    },
    {
      "path": ":id",
      "title": "Open a roadmap"
    }
  ],
  "commands": [
    {
      "id": "new-roadmap",
      "title": "New roadmap",
      "route": ""
    },
    {
      "id": "new-item",
      "title": "New roadmap item"
    },
    {
      "id": "export",
      "title": "Export roadmap"
    },
    {
      "id": "team-reports",
      "title": "Team reports",
      "route": "reports"
    }
  ],
  "files": [
    "app.css",
    "icons/app-192.png",
    "icons/app-512.png",
    "icons/app-maskable-512.png",
    "icons/app-touch-180.png",
    "icons/favicon-32.png",
    "icons/favicon.svg",
    "js/ado/index.js",
    "js/ado/model.js",
    "js/ado/publish.js",
    "js/ado/reports/index.js",
    "js/ado/reports/model.js",
    "js/ado/reports/view.js",
    "js/dates.js",
    "js/example.js",
    "js/export.js",
    "js/main.js",
    "js/model.js",
    "js/outline.js",
    "js/pending.js",
    "js/people.js",
    "js/store.js",
    "js/summary.js",
    "js/timeline.js",
    "js/view.js",
    "shared/device-fs.js",
    "shared/fonts/fonts.css",
    "shared/fonts/inter-latin-ext-wght-normal.woff2",
    "shared/fonts/inter-latin-wght-normal.woff2",
    "shared/fonts/jetbrains-mono-latin-ext-wght-normal.woff2",
    "shared/fonts/jetbrains-mono-latin-wght-normal.woff2",
    "shared/fonts/source-serif-4-latin-ext-opsz-normal.woff2",
    "shared/fonts/source-serif-4-latin-opsz-normal.woff2",
    "shared/pair.js",
    "shared/save-file.js",
    "shared/app-sw.js",
    "shared/handoffs.js",
    "shared/site.js",
    "shared/standalone-bar.js",
    "shared/people.js",
    "shared/summary.js",
    "shared/sw-register.js",
    "shared/teams.js",
    "shared/theme.js",
    "shared/themes.css",
    "shared/ui.css",
    "shared/vendor/xlsx.full.min.js",
    "shared/workshop-sdk.js"
  ]
}
