// Cloudflare Worker for runway.alexisdavidson.org: this repo's static files, nothing else.
// Deploy with `npx wrangler deploy` (or connect Workers Builds to deploy from main). Workshop
// (workshop.alexisdavidson.org) shows Runway inside its shell by proxying /apps/runway/* to this Worker
// (a service binding named RUNWAY in Workshop's wrangler.jsonc), so a deploy here updates both.
// Keep the name "runway": the binding refers to it.
{
  "name": "runway",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "runway.alexisdavidson.org", "custom_domain": true }
  ]
}
