{
  "manifestVersion": 1,
  "id": "bench",
  "name": "Bench",
  "version": "2.2.1",
  "description": "Tandem's test suite: which commands pass, fail or changed, what they cost, the lift over a plain prompt, history, and an improve loop that suggests and tests prompt fixes.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 70,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "connectors": [
    {
      "id": "opencode",
      "required": false
    }
  ],
  "aliases": [
    "bench",
    "evals",
    {
      "name": "eval history",
      "path": "history"
    },
    {
      "name": "run evals",
      "path": "run"
    },
    {
      "name": "improve prompts",
      "path": "improve"
    }
  ],
  "routes": [
    {
      "path": "improve",
      "title": "What fails, and experiments"
    },
    {
      "path": "history",
      "title": "Eval history and compare"
    },
    {
      "path": "run",
      "title": "Run evals and settings"
    },
    {
      "path": "lift",
      "title": "Tandem against a plain prompt, by case"
    },
    {
      "path": "command/:name",
      "title": "One command's cases and prompt"
    },
    {
      "path": "result/:file",
      "title": "Every run in a results file"
    }
  ],
  "commands": [
    {
      "id": "refresh",
      "title": "Refresh eval results"
    },
    {
      "id": "run",
      "title": "Run evals",
      "route": "run"
    },
    {
      "id": "history",
      "title": "Eval history",
      "route": "history"
    },
    {
      "id": "improve",
      "title": "Improve prompts",
      "route": "improve"
    }
  ],
  "files": [
    "bench.css",
    "js/main.js",
    "js/model.js",
    "js/view.js",
    "js/suite.js",
    "js/suite-view.js"
  ],
  "data": [
    "settings"
  ]
}
