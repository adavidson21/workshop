{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET and PUT /api/connectors/<id>/config response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "config",
    "env"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "schema": {
      "$ref": "config-form.schema.json"
    },
    "config": {
      "type": "object"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/envName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "set"
        ],
        "properties": {
          "set": {
            "type": "boolean"
          }
        }
      }
    },
    "secrets": {
      "description": "Secrets named in x-workshop-secret fields: whether `workshop secret set` saved one by that name, where, and its expiry. Never a value.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "set"
        ],
        "properties": {
          "set": {
            "type": "boolean"
          },
          "store": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires": {
            "type": [
              "string",
              "null"
            ]
          },
          "daysLeft": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
