{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared definitions",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "App id or connector id. Collection names and file paths use collectionName and filePath."
    },
    "collectionName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}(/[a-z0-9][a-z0-9-]{0,39}){0,3}$",
      "description": "A collection name: 1 to 4 \"/\"-separated segments, each matching ^[a-z0-9][a-z0-9-]{0,39}$ (may start with a digit). Maps to subfolders of the app folder."
    },
    "schemaName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}\\.[a-z0-9][a-z0-9-]{0,39}(/[a-z0-9][a-z0-9-]{0,39}){0,3}$",
      "description": "An envelope schema: \"<app>.<collection>\"."
    },
    "filePath": {
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9-]{0,39}/){0,3}[a-z0-9][a-z0-9-]{0,39}\\.(md|json)$",
      "description": "A file path inside an app folder: 1 to 4 \"/\"-separated segments, each matching ^[a-z0-9][a-z0-9-]{0,39}$ (may start with a digit), the last one ending in .md or .json."
    },
    "folderPath": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}(/[a-z0-9][a-z0-9-]{0,39}){0,2}$",
      "description": "A folder inside an app folder, for listing files."
    },
    "absPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/])",
      "description": "An absolute path: POSIX (\"/...\"), a Windows drive (\"C:\\\\...\" or \"C:/...\"), or a UNC path (\"\\\\\\\\server\\\\share\\\\...\")."
    },
    "actionName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)*$",
      "maxLength": 80
    },
    "isoTime": {
      "type": "string",
      "format": "date-time"
    },
    "msTime": {
      "type": "integer",
      "minimum": 0,
      "description": "Milliseconds since 1970-01-01 UTC."
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "origin": {
      "type": "string",
      "pattern": "^(https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]{1,5})?|http://(127\\.0\\.0\\.1|localhost)(:[0-9]{1,5})?)$"
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "errorCode": {
      "enum": [
        "bad_request",
        "invalid_config",
        "confirm_required",
        "downgrade",
        "unauthorized",
        "forbidden",
        "local_only",
        "not_found",
        "method_not_allowed",
        "conflict",
        "too_large",
        "disabled",
        "unavailable",
        "internal"
      ]
    },
    "connectorState": {
      "enum": [
        "disabled",
        "stopped",
        "starting",
        "ready",
        "error"
      ]
    },
    "connectorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "message",
        "since"
      ],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/connectorState"
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "since": {
          "$ref": "common.schema.json#/$defs/isoTime"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "runMode": {
      "enum": [
        "local",
        "hosted",
        "browser"
      ]
    },
    "backend": {
      "enum": [
        "agent",
        "browser"
      ]
    },
    "themeKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    }
  }
}
