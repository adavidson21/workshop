{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "port",
    "dataDir",
    "allowedOrigins",
    "features",
    "connectors",
    "home"
  ],
  "properties": {
    "configVersion": {
      "const": 1
    },
    "port": {
      "$ref": "config.schema.json#/$defs/port"
    },
    "dataDir": {
      "$ref": "common.schema.json#/$defs/absPath"
    },
    "allowedOrigins": {
      "$ref": "config.schema.json#/$defs/origins"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startAtLogin",
        "hostedMode"
      ],
      "properties": {
        "startAtLogin": {
          "type": "boolean"
        },
        "hostedMode": {
          "type": "boolean"
        },
        "workMode": {
          "type": "boolean",
          "description": "Work mode: the agent serves the pinned copy built by workshop pin, and no hosted site may pair or use the agent (docs/run-modes.md, Work mode)."
        }
      }
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "home": {
      "type": "string",
      "minLength": 1
    }
  }
}
