{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DELETE /api/files/<app>/<path> response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "path",
    "trash"
  ],
  "properties": {
    "app": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "path": {
      "$ref": "common.schema.json#/$defs/filePath"
    },
    "trash": {
      "type": "string",
      "pattern": "^\\.trash/[a-z][a-z0-9-]{0,39}/([a-z0-9][a-z0-9-]{0,39}/){0,3}[a-z0-9][a-z0-9-]{0,39}\\.[0-9]{8}T[0-9]{9}Z(-[0-9]{1,4})?\\.(md|json)$",
      "description": "Where the file went, relative to the data folder, with \"/\" separators."
    }
  }
}
