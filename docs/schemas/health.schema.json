{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "api",
    "version"
  ],
  "properties": {
    "app": {
      "const": "workshop-agent"
    },
    "api": {
      "const": 1
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "site": {
      "type": "string",
      "pattern": "^https://[^/]+$",
      "description": "Workshop's own site (shared/site.js, docs/site.md), so tools on this computer (Tandem's /dashboard) can link to the hosted hub without naming a domain. Agent 1.5.0 and later."
    }
  }
}
