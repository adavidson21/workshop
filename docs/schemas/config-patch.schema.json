{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUT /api/config body",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "port": {
      "$ref": "config.schema.json#/$defs/port"
    },
    "dataDir": {
      "$ref": "common.schema.json#/$defs/absPath"
    },
    "allowedOrigins": {
      "$ref": "config.schema.json#/$defs/origins"
    },
    "features": {
      "$ref": "config.schema.json#/$defs/features"
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
