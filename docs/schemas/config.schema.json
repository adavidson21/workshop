{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "~/.workshop/config.json",
  "description": "See docs/config.md. Unknown top-level keys are allowed and preserved.",
  "type": "object",
  "required": [
    "configVersion"
  ],
  "properties": {
    "configVersion": {
      "const": 1
    },
    "port": {
      "$ref": "#/$defs/port"
    },
    "dataDir": {
      "$ref": "common.schema.json#/$defs/absPath"
    },
    "allowedOrigins": {
      "$ref": "#/$defs/origins"
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "approvals": {
      "description": "Approvals (security.md, Approvals). Written by Workshop when you choose Always allow, and removed in Settings, Approvals.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "connector",
              "action",
              "scopes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^r-[0-9a-f]{8}$"
              },
              "connector": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "action": {
                "type": "string",
                "maxLength": 64
              },
              "scopes": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "created": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        }
      }
    },
    "routines": {
      "description": "Routines (config.md, Routines): Tandem commands or prompts Workshop starts on a schedule on this computer.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "run",
          "schedule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rt-[0-9a-f]{8}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "run": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4000,
            "description": "A slash command (/cloudflare why workshop) or a prompt."
          },
          "agent": {
            "type": "string",
            "maxLength": 64
          },
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "days",
              "time"
            ],
            "properties": {
              "days": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekdays",
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "created": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "origins": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/origin"
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "startAtLogin": {
          "type": "boolean"
        },
        "hostedMode": {
          "type": "boolean"
        },
        "workMode": {
          "type": "boolean",
          "description": "Work mode: the agent serves the pinned copy built by workshop pin, and no hosted site may pair or use the agent (docs/run-modes.md, Work mode)."
        },
        "readableCopy": {
          "type": "boolean",
          "description": "Keep the readable copy of the data folder up to date: made on start and once a day (docs/data-format.md, Readable without Workshop). Off by default."
        }
      }
    }
  }
}
