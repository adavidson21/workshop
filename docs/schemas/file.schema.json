{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/files/<app>/<path>",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "path",
    "mtime",
    "size",
    "content"
  ],
  "properties": {
    "app": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "path": {
      "$ref": "common.schema.json#/$defs/filePath"
    },
    "mtime": {
      "$ref": "common.schema.json#/$defs/msTime"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "content": {
      "type": "string",
      "description": "The whole file as UTF-8 text."
    }
  }
}
