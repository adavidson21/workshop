{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A product: one item of settings.products v1",
  "description": "A product you work on, owned by Settings. Folio makes its note, products/<slug>.md. See products.md.",
  "type": "object",
  "required": [
    "id",
    "updatedAt",
    "name",
    "slug"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^p_[a-z0-9][a-z0-9-]{0,39}$"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/msTime"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "alsoCalled": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "repos": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "areas": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "changeOrder": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Repos in the order a change goes through them (shared ones first)."
    },
    "together": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "Repos that usually change together, one group per string (for example \"api + ui\")."
    },
    "entryPoints": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "Files to start reading from, workspace-relative."
    },
    "external": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "Systems outside the repos this product talks to."
    },
    "processes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "Business processes (place an order, issue a refund)."
    },
    "docsFolder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Workspace-relative folder with the product's user-facing docs."
    },
    "archived": {
      "type": "boolean"
    }
  }
}
