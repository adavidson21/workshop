{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "409 conflict body for a data put",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error",
    "code",
    "current"
  ],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "const": "conflict"
    },
    "current": {
      "$ref": "data-envelope.schema.json"
    }
  }
}
