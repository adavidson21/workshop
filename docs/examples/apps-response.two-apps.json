{
  "apps": [
    {
      "base": "/apps/prioritizer/",
      "manifest": {
        "manifestVersion": 1,
        "id": "prioritizer",
        "name": "Prioritizer",
        "version": "3.0.0",
        "description": "Decide what to work on next.",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 10,
        "modes": [
          "local",
          "hosted",
          "browser"
        ],
        "routes": [
          {
            "path": "task/:id",
            "title": "Open a task"
          }
        ],
        "connectors": [
          {
            "id": "ado",
            "required": false
          },
          {
            "id": "opencode",
            "required": false
          }
        ],
        "data": [
          "tasks",
          "lists"
        ],
        "commands": [
          {
            "id": "add-task",
            "title": "Add a task",
            "route": ""
          },
          {
            "id": "sync-ado",
            "title": "Sync ADO"
          }
        ],
        "shortcuts": [
          {
            "keys": "Ctrl+Shift+A",
            "command": "add-task",
            "scope": "global"
          }
        ],
        "files": [
          "app.css",
          "js/main.js",
          "js/state.js"
        ]
      }
    },
    {
      "base": "/apps/agents/",
      "manifest": {
        "manifestVersion": 1,
        "id": "agents",
        "name": "Agents",
        "version": "1.0.0",
        "icon": "icon.svg",
        "entry": "index.html",
        "order": 20,
        "modes": [
          "local",
          "hosted"
        ],
        "routes": [
          {
            "path": ":id",
            "title": "Focus a work item"
          }
        ],
        "connectors": [
          {
            "id": "opencode",
            "required": true
          }
        ]
      }
    }
  ]
}
