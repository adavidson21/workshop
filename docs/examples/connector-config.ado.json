{
  "id": "ado",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "connections"
    ],
    "properties": {
      "connections": {
        "type": "array",
        "title": "Connections",
        "description": "One per ADO server and collection.",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "serverUrl",
            "collection",
            "patEnv"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Name",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            },
            "serverUrl": {
              "type": "string",
              "title": "Server URL",
              "format": "uri",
              "description": "The part before the collection, for example https://ado.example.com or https://ado.example.com/tfs."
            },
            "collection": {
              "type": "string",
              "title": "Collection"
            },
            "project": {
              "type": "string",
              "title": "Project",
              "description": "Used when a work item does not say its project."
            },
            "patEnv": {
              "type": "string",
              "title": "PAT environment variable",
              "x-workshop-env": true,
              "default": "ADO_PAT"
            },
            "apiVersion": {
              "type": "string",
              "title": "API version",
              "default": "6.0",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "useSystemCa": {
              "type": "boolean",
              "title": "Trust certificates trusted by this computer",
              "description": "Needed when the ADO server uses a company certificate.",
              "default": true
            },
            "verifyTls": {
              "type": "boolean",
              "title": "Check the server certificate",
              "description": "Turn off only if your ADO server has a broken certificate and you accept the risk.",
              "default": true
            }
          }
        }
      },
      "defaultConnection": {
        "type": "string",
        "title": "Default connection"
      },
      "syncConnection": {
        "type": "string",
        "title": "Connection for my work items",
        "description": "Empty means the default connection."
      },
      "paths": {
        "type": "array",
        "title": "Repo and path mapping",
        "description": "Which connection and project a repo or folder uses. * matches any characters.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "connection"
          ],
          "properties": {
            "path": {
              "type": "string",
              "title": "Repo or folder"
            },
            "connection": {
              "type": "string",
              "title": "Connection"
            },
            "project": {
              "type": "string",
              "title": "Project"
            }
          }
        }
      },
      "types": {
        "type": "array",
        "title": "Work item types",
        "items": {
          "type": "string"
        },
        "default": [
          "Issue",
          "Bug",
          "User Story"
        ]
      },
      "closedStates": {
        "type": "array",
        "title": "States that count as done",
        "items": {
          "type": "string"
        },
        "default": [
          "Resolved",
          "Closed",
          "Done"
        ]
      },
      "removedStates": {
        "type": "array",
        "title": "States that count as won't do",
        "items": {
          "type": "string"
        },
        "default": [
          "Removed"
        ]
      },
      "prSources": {
        "type": "array",
        "title": "Pull request sources",
        "description": "Where to look for pull requests waiting on you. Empty skips PRs.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection",
            "project"
          ],
          "properties": {
            "connection": {
              "type": "string",
              "title": "Connection"
            },
            "project": {
              "type": "string",
              "title": "Project"
            },
            "repos": {
              "type": "array",
              "title": "Only these repos",
              "description": "Empty means every repo in the project.",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "prTeams": {
        "type": "array",
        "title": "Teams that count as mine",
        "description": "Empty means every team you are on.",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "reports": {
        "type": "object",
        "title": "Team reports",
        "additionalProperties": false,
        "properties": {
          "workloadTypes": {
            "type": "array",
            "title": "Work item types in reports",
            "description": "Empty means the same as Work item types.",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "bugTypes": {
            "type": "array",
            "title": "Types counted as bugs",
            "items": {
              "type": "string"
            },
            "default": [
              "Bug"
            ]
          },
          "highPriorities": {
            "type": "array",
            "title": "Priorities that count as high",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "default": [
              "1",
              "2"
            ]
          },
          "escalationPriority": {
            "type": "integer",
            "title": "Raised to this priority counts as an escalation",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "effortFields": {
            "type": "array",
            "title": "Effort fields, first one set wins",
            "items": {
              "type": "string"
            },
            "default": [
              "Microsoft.VSTS.Scheduling.RemainingWork",
              "Microsoft.VSTS.Scheduling.Effort",
              "Microsoft.VSTS.Scheduling.StoryPoints",
              "Microsoft.VSTS.Scheduling.OriginalEstimate"
            ]
          },
          "maxItems": {
            "type": "integer",
            "title": "Most changed items to read history for",
            "minimum": 50,
            "maximum": 5000,
            "default": 1500
          }
        }
      }
    }
  },
  "config": {
    "connections": [
      {
        "name": "work",
        "serverUrl": "https://ado.example.com",
        "collection": "Main",
        "project": "Web",
        "patEnv": "ADO_PAT"
      }
    ],
    "defaultConnection": "work",
    "paths": [
      {
        "path": "C:/src/work/api-repo",
        "connection": "work",
        "project": "Web"
      }
    ],
    "types": [
      "Issue",
      "Bug",
      "User Story"
    ],
    "closedStates": [
      "Resolved",
      "Closed",
      "Done"
    ],
    "removedStates": [
      "Removed"
    ],
    "prSources": [
      {
        "connection": "work",
        "project": "Web",
        "repos": []
      }
    ],
    "prTeams": [],
    "reports": {
      "workloadTypes": [],
      "bugTypes": [
        "Bug"
      ],
      "highPriorities": [
        "1",
        "2"
      ],
      "escalationPriority": 1,
      "effortFields": [
        "Microsoft.VSTS.Scheduling.RemainingWork",
        "Microsoft.VSTS.Scheduling.Effort",
        "Microsoft.VSTS.Scheduling.StoryPoints",
        "Microsoft.VSTS.Scheduling.OriginalEstimate"
      ],
      "maxItems": 1500
    }
  },
  "env": {
    "ADO_PAT": {
      "set": true
    }
  }
}
