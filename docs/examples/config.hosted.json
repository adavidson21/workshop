{
  "configVersion": 1,
  "port": 4380,
  "allowedOrigins": [
    "https://work.example.org"
  ],
  "features": {
    "startAtLogin": true,
    "hostedMode": true
  },
  "connectors": {
    "ado": {
      "enabled": true,
      "config": {
        "connections": [
          {
            "name": "work",
            "serverUrl": "https://ado.example.com",
            "collection": "Main",
            "project": "Web",
            "patEnv": "ADO_PAT"
          }
        ],
        "defaultConnection": "work",
        "paths": [
          {
            "path": "C:/src/work/api-repo",
            "connection": "work",
            "project": "Web"
          }
        ],
        "types": [
          "Issue",
          "Bug",
          "User Story"
        ],
        "closedStates": [
          "Resolved",
          "Closed",
          "Done"
        ],
        "removedStates": [
          "Removed"
        ],
        "prSources": [
          {
            "connection": "work",
            "project": "Web",
            "repos": []
          }
        ]
      }
    },
    "opencode": {
      "enabled": false
    }
  }
}
