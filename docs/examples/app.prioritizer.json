{
  "manifestVersion": 1,
  "id": "prioritizer",
  "name": "Prioritizer",
  "version": "3.0.0",
  "description": "Decide what to work on next.",
  "icon": "icon.svg",
  "entry": "index.html",
  "order": 10,
  "modes": [
    "local",
    "hosted",
    "browser"
  ],
  "routes": [
    {
      "path": "task/:id",
      "title": "Open a task"
    }
  ],
  "connectors": [
    {
      "id": "ado",
      "required": false
    },
    {
      "id": "opencode",
      "required": false
    }
  ],
  "data": [
    "tasks",
    "lists"
  ],
  "commands": [
    {
      "id": "add-task",
      "title": "Add a task",
      "route": ""
    },
    {
      "id": "sync-ado",
      "title": "Sync ADO"
    }
  ],
  "shortcuts": [
    {
      "keys": "Ctrl+Shift+A",
      "command": "add-task",
      "scope": "global"
    }
  ],
  "files": [
    "app.css",
    "js/main.js",
    "js/state.js"
  ],
  "handoffs": {
    "sends": [
      "receipts"
    ]
  },
  "capture": [
    "task",
    "waiting"
  ],
  "aliases": [
    "docket",
    "tasks",
    "board",
    {
      "name": "today",
      "path": "today"
    }
  ],
  "settings": [
    {
      "id": "sprints",
      "type": "boolean",
      "title": "Use sprints",
      "description": "Plan days by sprint day and add every-sprint tasks. Off: Day templates are by weekday.",
      "default": true
    }
  ]
}
